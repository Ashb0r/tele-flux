# =====================================================================
# Git Ignore for Telegram Stremio Addon
# Protects your sensitive Telegram API credentials, session keys, and database
# =====================================================================
# Environment variables & secrets
.env
.env.local
.env.*.local
# Persistent runtime data directory
# (Contains library.db, settings.json, and Telegram MTProto session keys)
data/
*.session
*.session-journal
# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
# Virtual environments
venv/
.venv/
env/
ENV/
# System and IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db