# =====================================================================
# Telegram Stremio Addon Server Settings
# =====================================================================

# Server network binding
SERVER_HOST=0.0.0.0
SERVER_PORT=7000

# The LAN IP or domain address reachable by Stremio on your devices
# (e.g. http://192.168.1.100:7000 or https://stremio.yourdomain.com)
PUBLIC_URL=http://192.168.1.100:7000

# Streaming chunk size in KB (512 is recommended for smooth bufferless playback)
CHUNK_SIZE_KB=512

# =====================================================================
# Optional: Headless Setup
# (You do NOT need to fill these here if you use the Web UI at /configure)
# =====================================================================
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=your_telegram_api_hash_here
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHI...
# TMDB_API_KEY=your_tmdb_api_key_here
# Streaming channels (comma-separated channel IDs)
# CHANNEL_IDS=-1001234567890

# Dedicated local download channels (comma-separated channel IDs, independent from streaming)
# DOWNLOAD_CHANNEL_IDS=-1001234567890

# Media archive storage path (Movies, TV Shows, Unsorted, .downloads)
# MEDIA_DIR=/media
