# =====================================================================
# Telegram Stremio Addon Server Settings
# =====================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=7000

# The LAN IP or domain address reachable by Stremio on your devices
# (e.g. http://192.168.1.100:7000 or https://stremio.yourdomain.com)
PUBLIC_URL=http://127.0.0.1:7000

# =====================================================================
# Telegram API Credentials
# =====================================================================

# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=

# =====================================================================
# High-Performance Streaming Engine Configuration
# =====================================================================

# Aligned block size in KB (512 KB is the MTProto protocol limit per chunk.
# 512 KB delivers <50ms first-packet arrival for instant video start & seeks).
STREAM_BLOCK_SIZE_KB=512

# Max parallel MTProto chunk requests per playback stream (4 connections fetch
# 2 MB simultaneously in parallel, easily saturating 4K / 1080p high bitrates).
STREAM_PARALLEL_CONNECTIONS=4

# Global maximum concurrent MTProto block requests across all active streams.
# 8 prevents Telegram flood limits while allowing multiple streams to run smoothly.
STREAM_GLOBAL_MAX_REQUESTS=8

# Shared in-memory LRU block cache in MB (128 MB caches ~256 video blocks,
# keeping headers, moov atoms, and recently seeked regions in 0.001ms RAM).
STREAM_CACHE_MAX_MB=128

# Minimum read-ahead buffer in MB (6 MB = 12 blocks ahead of playback head).
STREAM_PREFETCH_MIN_MB=6

# Maximum speculative read-ahead buffer in MB (16 MB = 32 blocks ahead).
STREAM_PREFETCH_MAX_MB=16

# Maximum concurrent playback streams permitted simultaneously.
STREAM_MAX_ACTIVE_STREAMS=4

# =====================================================================
# Downloader & Local Archive Module Settings
# =====================================================================

# Downloader chunk size in KB (512 KB is optimal for multi-connection downloads)
DOWNLOAD_CHUNK_SIZE_KB=512

# Parallel MTProto connections for background downloading
DOWNLOAD_PARALLEL_CONNECTIONS=6

# Directory for downloaded media library
# MEDIA_DIR=./media

# Root data directory for databases and temporary files
DATA_DIR=./data

# Minimum free disk space required to accept new downloads (in GB)
# MIN_FREE_DISK_GB=5.0

# TMDb API Key for automatic poster and metadata identification
# TMDB_API_KEY=