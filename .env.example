# =====================================================================
# Telegram Stremio Addon Server Settings
# =====================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=7000
PUBLIC_URL=http://127.0.0.1:7000

# Root data directory for SQLite database, settings, and session
DATA_DIR=./data

# Mode Toggle: Set to True for dedicated Adult/StashDB setup; False for standard Movies & TV Series (TMDB)
ADULT_ONLY=False

# =====================================================================
# Telegram API Credentials (loaded exclusively from .env)
# Obtain from https://my.telegram.org/apps
# =====================================================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Streaming Channel IDs (comma-separated chat IDs, e.g. -1004421826021)
CHANNEL_IDS=

# =====================================================================
# Metadata API Keys
# =====================================================================
# TMDb API Key for movies & TV series (used when ADULT_ONLY=False)
TMDB_API_KEY=

# StashDB API Key for adult scenes, performers, & studio metadata (used when ADULT_ONLY=True)
STASHDB_API_KEY=
